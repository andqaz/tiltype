{
  "$schema": "https://raw.githubusercontent.com/ONLYOFFICE/doceditor-plugin-types/refs/heads/master/schemas/config.schema.json",
  "name": "TilType AI",
  "offered": "Andrey Komarov",
  "help": "https://github.com/andqaz/tiltype#readme",
  "guid": "asc.{E9067D1A-F74B-4F0F-9B6A-2EEB4779F433}",
  "version": "1.7.0",
  "minVersion": "10.0.0",
  "variations": [
    {
      "description": "Offline word and phrase completion, spelling, keyboard layout correction and punctuation for Kazakh, Russian and English.",
      "descriptionLocale": {
        "ru": "Офлайн-подсказки слов и фраз на казахском, русском и английском. Проверка орфографии, исправление раскладки и пунктуации.",
        "kk": "Қазақша, орысша және ағылшынша сөздер мен тіркестерді офлайн ұсыну. Емлені тексеру, пернетақта жаймасы мен тыныс белгілерін түзету."
      },
      "url": "index.html",
      "icons": "resources/%theme-type%(light|dark)/icon%scale%(default).%extension%(png)",
      "isViewer": false,
      "EditorsSupport": [
        "word",
        "slide",
        "cell"
      ],
      "type": "background",
      "initDataType": "none",
      "store": {
        "background": {
          "light": "#EAF7F1",
          "dark": "#1D2B30"
        },
        "icons": {
          "light": "resources/store/icons",
          "dark": "resources/store/icons"
        },
        "categories": [
          "work"
        ],
        "screenshots": [
          "resources/store/screenshots/suggestions.png",
          "resources/store/screenshots/punctuation.png",
          "resources/store/screenshots/settings.png"
        ]
      }
    }
  ]
}
